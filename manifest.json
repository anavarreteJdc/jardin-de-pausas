{
  "manifest_version": 3,
  "name": "Jardín de pausas",
  "version": "1.0.0",
  "description": "Temporizador de enfoque y descanso: una flor crece mientras te concentras y suelta sus pétalos mientras descansas.",
  "author": "Arturo Navarrete Jiménez de Cisneros",

  "icons": {
    "48": "icons/icono-48.png",
    "96": "icons/icono-96.png"
  },

  "action": {
    "default_title": "Jardín de pausas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icono-16.png",
      "32": "icons/icono-32.png",
      "48": "icons/icono-48.png"
    }
  },

  "permissions": ["storage"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "jardin-de-pausas@arturo-navarrete.uoc",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
